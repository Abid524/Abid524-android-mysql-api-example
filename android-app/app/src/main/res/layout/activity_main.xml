<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Login Container -->
    <LinearLayout
        android:id="@+id/login_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API Authentication Demo"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/email_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/password_input"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/edit_text" />

        <Button
            android:id="@+id/login_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Login / Sign Up" />
    </LinearLayout>

    <!-- Data Container -->
    <ScrollView
        android:id="@+id/data_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <Button
                    android:id="@+id/fetch_data_button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Fetch Posts"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/logout_button"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="Logout" />
            </LinearLayout>

            <EditText
                android:id="@+id/post_title_input"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:hint="Post Title"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:background="@android:drawable/edit_text" />

            <EditText
                android:id="@+id/post_description_input"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Post Description"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:gravity="top"
                android:background="@android:drawable/edit_text" />

            <Button
                android:id="@+id/create_post_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Create Post (Admin Only)"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Posts:"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/posts_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No posts loaded"
                android:textSize="14sp"
                android:padding="8dp" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
</LinearLayout>
